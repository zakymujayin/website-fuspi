window.gtranslateSettings = /* document.write */ window.gtranslateSettings || {};window.gtranslateSettings['48297770'] = {"default_language":"id","languages":["ar","en","id"],"url_structure":"none","native_language_names":1,"wrapper_selector":"#gt-wrapper-48297770","flag_size":24,"globe_size":60,"alt_flags":[],"globe_color":"#e5d600","horizontal_position":"left","vertical_position":"bottom"};
