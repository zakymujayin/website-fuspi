generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  id
  en
  ar
}

enum TranslationStatus {
  DRAFT
  REVIEWED
  PUBLISHED
  STALE
}

enum GovernanceStatus {
  CURRENT
  REVIEW_DUE
  STALE
  EXPIRED
  ARCHIVED
}

enum Role {
  ADMIN
  EDITOR
  PETUGAS
  SATGAS_PPKS
  DOSEN
}

enum PublicationType {
  JURNAL
  BUKU
  BAB_BUKU
  PROSIDING
  ARTIKEL
  LAINNYA
}

enum PostType {
  BERITA
  PENGUMUMAN
  INFORMASI
  KOLOM
}

enum ColumnType {
  DEKAN
  DOSEN
  MAHASISWA
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StorageClass {
  PUBLIC
  PRIVATE
  PPKS_PRIVATE
}

enum UnitType {
  PUSAT_STUDI
  LABORATORIUM
  ORGANISASI_MAHASISWA
  LEMBAGA
}

enum PartnershipLevel {
  INTERNASIONAL
  NASIONAL
  LOKAL
}

enum ServiceCategory {
  AKADEMIK
  LABORATORIUM
  UMUM
}

enum AchievementLevel {
  INTERNASIONAL
  NASIONAL
  REGIONAL
  LOKAL
}

enum MenuLocation {
  CONTENT_BAR
  TOPBAR
  HEADER
  FOOTER
}

enum LinkCategory {
  TERKAIT
  JURNAL
}

enum HomeSectionKey {
  HERO
  QUICKLINK
  DEAN
  STATS
  INTRO
  NEWS
  ANNOUNCEMENT
  SERVICE
  FACILITY
  PRODI
  PARTNERSHIP
  VIDEO
  VIDEO_GALLERY
  AGENDA
  TESTIMONIAL
  COLUMN
  ACHIEVEMENT
  CTA
}

enum ComplaintCategory {
  AKADEMIK
  KEMAHASISWAAN
  SARANA
  PELECEHAN_SEKSUAL
  LAINNYA
}

enum TicketPriority {
  RENDAH
  SEDANG
  TINGGI
  URGENT
}

enum TicketStatus {
  BARU
  DIVERIFIKASI
  DIPROSES
  MENUNGGU_PELAPOR
  SELESAI
  DITOLAK
}

enum TicketAccessAction {
  VIEW
  EXPORT
  REPLY
  ASSIGN
  STATUS_CHANGE
  ATTACHMENT_DOWNLOAD
}

enum TicketEvent {
  CREATED
  ASSIGNED
  REPLIED
  STATUS_CHANGED
  PRIORITY_CHANGED
  PAUSED
  RESUMED
  CLOSED
}

enum BookingStatus {
  DIAJUKAN
  DISPOSISI_DEKAN
  CEK_KETERSEDIAAN
  PERLU_REVISI
  MENUNGGU
  DISETUJUI
  DITOLAK
  DIBATALKAN
  SELESAI
}

enum ActivityAction {
  CREATE
  UPDATE
  PUBLISH
  ARCHIVE
  LOGIN
  LOGIN_FAILED
  VIEW_SENSITIVE
  EXPORT
  CHANGE_ROLE
  CHANGE_PASSWORD
}

enum SequenceKind {
  TICKET
  BOOKING
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum SurveyQuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING
}

enum PrivacyRequestType {
  ACCESS
  CORRECTION
  ERASURE
  RESTRICTION
  OBJECTION
}

enum PrivacyRequestStatus {
  RECEIVED
  VERIFYING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum VerificationState {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum DataIncidentStatus {
  OPEN
  CONTAINED
  INVESTIGATING
  RESOLVED
}

enum AccessibilityIssueStatus {
  OPEN
  IN_PROGRESS
  FIXED
  VERIFIED
  ACCEPTED_RISK
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AccessibilityRequestStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum AlertLevel {
  INFO
  WARNING
  CRITICAL
}

enum AlertAudience {
  ALL
  PUBLIC
  ADMIN
}

enum ServiceIncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum RetentionDisposition {
  DELETE
  ANONYMIZE
  HOLD
}

enum ServiceHealth {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
  MAINTENANCE
}

model User {
  id                 String            @id @default(cuid())
  name               String
  email              String            @unique
  emailVerified      DateTime?
  passwordHash       String?
  image              String?
  role               Role              @default(EDITOR)
  isActive           Boolean           @default(true)
  mustChangePassword Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  accounts           Account[]
  sessions           Session[]
  authenticators     Authenticator[]
  posts              Post[]            @relation("PostAuthor")
  media              Media[]           @relation("MediaUploader")
  assignedTickets    Ticket[]          @relation("TicketAssignee")
  ticketReplies      TicketReply[]     @relation("TicketReplyAuthor")
  ticketAccessLogs   TicketAccessLog[]
  approvedBookings   Booking[]         @relation("BookingApprover")
  activityLogs       ActivityLog[]
  lecturerProfile    Lecturer?         @relation("LecturerAccount")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String  @db.Text
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Post {
  id               String             @id @default(cuid())
  type             PostType           @default(BERITA)
  columnType       ColumnType?
  slug             String             @unique
  status           ContentStatus      @default(DRAFT)
  isFeatured       Boolean            @default(false)
  viewCount        Int                @default(0)
  publishedAt      DateTime?
  version          Int                @default(1)
  categoryId       String?
  authorId         String?
  coverMediaId     String?
  contentOwnerId   String?
  governanceStatus GovernanceStatus   @default(CURRENT)
  lastReviewedAt   DateTime?
  lastReviewedById String?
  reviewDueAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author           User?              @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  coverMedia       Media?             @relation("PostCover", fields: [coverMediaId], references: [id], onDelete: Restrict)
  translations     PostTranslation[]
  tags             PostTag[]
  lecturers        LecturerPost[]
  studyPrograms    StudyProgramPost[]
  images           PostImage[]

  @@index([type, status, publishedAt])
  @@index([contentOwnerId, reviewDueAt])
}

model PostImage {
  id      String  @id @default(cuid())
  postId  String
  mediaId String
  caption String?
  order   Int     @default(0)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  media   Media   @relation("PostImageMedia", fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([postId, mediaId])
}

model PostTranslation {
  id            String            @id @default(cuid())
  postId        String
  locale        Locale
  title         String            @db.VarChar(255)
  excerpt       String?           @db.VarChar(500)
  content       String            @db.Text
  metaTitle     String?
  metaDesc      String?           @db.VarChar(500)
  coverCaption  String?
  status        TranslationStatus @default(DRAFT)
  sourceVersion Int               @default(1)
  translatorId  String?
  reviewerId    String?
  reviewedAt    DateTime?
  post          Post              @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([locale])
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  createdAt    DateTime              @default(now())
  posts        Post[]
  translations CategoryTranslation[]
}

model CategoryTranslation {
  id            String            @id @default(cuid())
  categoryId    String
  locale        Locale
  name          String
  status        TranslationStatus @default(DRAFT)
  sourceVersion Int               @default(1)
  translatorId  String?
  reviewerId    String?
  reviewedAt    DateTime?
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

model Tag {
  id           String           @id @default(cuid())
  slug         String           @unique
  posts        PostTag[]
  translations TagTranslation[]
}

model TagTranslation {
  id            String            @id @default(cuid())
  tagId         String
  locale        Locale
  name          String
  status        TranslationStatus @default(DRAFT)
  sourceVersion Int               @default(1)
  translatorId  String?
  reviewerId    String?
  reviewedAt    DateTime?
  tag           Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@index([locale])
}

model PostTag {
  postId    String
  tagId     String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Page {
  id               String            @id @default(cuid())
  slug             String            @unique
  status           ContentStatus     @default(DRAFT)
  order            Int               @default(0)
  version          Int               @default(1)
  parentId         String?
  heroMediaId      String?
  contentOwnerId   String?
  governanceStatus GovernanceStatus  @default(CURRENT)
  lastReviewedAt   DateTime?
  lastReviewedById String?
  reviewDueAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  parent           Page?             @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Page[]            @relation("PageTree")
  heroMedia        Media?            @relation("PageHero", fields: [heroMediaId], references: [id], onDelete: Restrict)
  translations     PageTranslation[]
  menuItems        MenuItem[]        @relation("MenuPage")

  @@index([contentOwnerId, reviewDueAt])
}

model PageTranslation {
  id            String            @id @default(cuid())
  pageId        String
  locale        Locale
  title         String            @db.VarChar(255)
  content       String            @db.Text
  metaTitle     String?
  metaDesc      String?           @db.VarChar(500)
  status        TranslationStatus @default(DRAFT)
  sourceVersion Int               @default(1)
  translatorId  String?
  reviewerId    String?
  reviewedAt    DateTime?
  page          Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@index([locale])
}

model Media {
  id                     String          @id @default(cuid())
  storageKey             String          @unique
  storageClass           StorageClass    @default(PUBLIC)
  checksumSha256         String
  originalName           String
  mimeType               String
  size                   Int
  alt                    String?
  isDecorative           Boolean         @default(false)
  width                  Int?
  height                 Int?
  focalX                 Float?
  focalY                 Float?
  encryptionNonce        String?
  encryptionTag          String?
  keyVersion             Int?
  uploaderId             String?
  createdAt              DateTime        @default(now())
  uploader               User?           @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  postCovers             Post[]          @relation("PostCover")
  pageHeroes             Page[]          @relation("PageHero")
  lecturerPhotos         Lecturer[]      @relation("LecturerPhoto")
  lecturerCvs            Lecturer[]      @relation("LecturerCv")
  staffPhotos            Staff[]         @relation("StaffPhoto")
  programLogos           StudyProgram[]  @relation("StudyProgramLogo")
  partnershipLogos       Partnership[]   @relation("PartnershipLogo")
  achievementImages      Achievement[]   @relation("AchievementImage")
  albumCovers            Album[]         @relation("AlbumCover")
  albumPhotos            AlbumPhoto[]    @relation("AlbumPhotoMedia")
  sliderImages           HomeSlider[]    @relation("SliderImage")
  sectionBackgrounds     HomeSection[]   @relation("SectionBackground")
  testimonialPhotos      Testimonial[]   @relation("TestimonialPhoto")
  activityImages         ActivityImage[] @relation("ActivityImageMedia")
  deanPhotos             SiteSetting[]   @relation("DeanPhoto")
  siteVideoPosters       SiteSetting[]   @relation("SiteVideoPoster")
  siteLogos              SiteSetting[]   @relation("SiteLogo")
  siteAccreditationLogos SiteSetting[]   @relation("SiteAccreditationLogo")
  siteBluLogos           SiteSetting[]   @relation("SiteBluLogo")
  siteFavicons           SiteSetting[]   @relation("SiteFavicon")
  facilityCovers         Facility[]      @relation("FacilityCover")
  postImages             PostImage[]     @relation("PostImageMedia")
}

model StudyProgram {
  id                   String                    @id @default(cuid())
  code                 String                    @unique
  slug                 String                    @unique
  degree               String
  accreditation        String?
  accreditationExpiry  DateTime?
  externalUrl          String?
  email                String?
  phone                String?
  logoMediaId          String?
  curriculumDocumentId String?
  brochureDocumentId   String?
  isActive             Boolean                   @default(true)
  order                Int                       @default(0)
  version              Int                       @default(1)
  contentOwnerId       String?
  governanceStatus     GovernanceStatus          @default(CURRENT)
  lastReviewedAt       DateTime?
  lastReviewedById     String?
  reviewDueAt          DateTime?
  expiresAt            DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  logoMedia            Media?                    @relation("StudyProgramLogo", fields: [logoMediaId], references: [id], onDelete: Restrict)
  curriculumDocument   Document?                 @relation("ProgramCurriculum", fields: [curriculumDocumentId], references: [id], onDelete: SetNull)
  brochureDocument     Document?                 @relation("ProgramBrochure", fields: [brochureDocumentId], references: [id], onDelete: SetNull)
  translations         StudyProgramTranslation[]
  lecturers            Lecturer[]
  posts                StudyProgramPost[]
  albums               StudyProgramAlbum[]

  @@index([contentOwnerId, reviewDueAt])
}

model StudyProgramTranslation {
  id               String            @id @default(cuid())
  studyProgramId   String
  locale           Locale
  name             String
  description      String?           @db.Text
  vision           String?           @db.Text
  mission          String?           @db.Text
  objectives       String?           @db.Text
  graduateProfile  String?           @db.Text
  careerProspects  String?           @db.Text
  learningOutcomes String?           @db.Text
  status           TranslationStatus @default(DRAFT)
  sourceVersion    Int               @default(1)
  translatorId     String?
  reviewerId       String?
  reviewedAt       DateTime?
  studyProgram     StudyProgram      @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)

  @@unique([studyProgramId, locale])
  @@index([locale])
}

model Lecturer {
  id                String                     @id @default(cuid())
  name              String
  slug              String                     @unique
  nidn              String?                    @unique
  nip               String?                    @unique
  orcid             String?                    @unique
  googleScholarUrl  String?
  sintaUrl          String?
  scopusUrl         String?
  linkedinUrl       String?
  instagramUrl      String?
  twitterUrl        String?
  email             String?
  phone             String?
  photoMediaId      String?
  cvMediaId         String?
  studyProgramId    String?
  userId            String?                    @unique
  order             Int                        @default(0)
  isActive          Boolean                    @default(true)
  photoMedia        Media?                     @relation("LecturerPhoto", fields: [photoMediaId], references: [id], onDelete: Restrict)
  cvMedia           Media?                     @relation("LecturerCv", fields: [cvMediaId], references: [id], onDelete: Restrict)
  studyProgram      StudyProgram?              @relation(fields: [studyProgramId], references: [id], onDelete: SetNull)
  user              User?                      @relation("LecturerAccount", fields: [userId], references: [id], onDelete: SetNull)
  translations      LecturerTranslation[]
  educations        LecturerEducation[]
  publications      LecturerPublication[]
  research          LecturerResearch[]
  communityServices LecturerCommunityService[]
  posts             LecturerPost[]
}

model LecturerEducation {
  id          String   @id @default(cuid())
  lecturerId  String
  degree      String
  field       String?
  institution String
  city        String?
  year        Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lecturer    Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@index([lecturerId, order])
}

model LecturerPublication {
  id         String          @id @default(cuid())
  lecturerId String
  title      String          @db.VarChar(500)
  type       PublicationType @default(JURNAL)
  year       Int?
  publisher  String?
  url        String?
  doi        String?
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  lecturer   Lecturer        @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@index([lecturerId, year])
}

model LecturerTranslation {
  id             String            @id @default(cuid())
  lecturerId     String
  locale         Locale
  position       String?
  expertise      String?
  bio            String?           @db.Text
  quote          String?           @db.Text
  officeHours    String?
  officeLocation String?
  status         TranslationStatus @default(DRAFT)
  sourceVersion  Int               @default(1)
  translatorId   String?
  reviewerId     String?
  reviewedAt     DateTime?
  lecturer       Lecturer          @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@unique([lecturerId, locale])
  @@index([locale])
}

model Staff {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  nip          String?            @unique
  email        String?
  phone        String?
  photoMediaId String?
  order        Int                @default(0)
  isActive     Boolean            @default(true)
  photoMedia   Media?             @relation("StaffPhoto", fields: [photoMediaId], references: [id], onDelete: Restrict)
  translations StaffTranslation[]
}

model StaffTranslation {
  id            String            @id @default(cuid())
  staffId       String
  locale        Locale
  position      String?
  unit          String?
  status        TranslationStatus @default(DRAFT)
  sourceVersion Int               @default(1)
  translatorId  String?
  reviewerId    String?
  reviewedAt    DateTime?
  staff         Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, locale])
  @@index([locale])
}

model Research {
  id              String                @id @default(cuid())
  slug            String                @unique
  year            Int
  publicationType String?
  doi             String?
  repositoryUrl   String?
  publisher       String?
  journal         String?
  volume          String?
  issue           String?
  pages           String?
  publicationDate DateTime?
  language        Locale?
  peerReviewed    Boolean               @default(false)
  documentUrl     String?
  createdAt       DateTime              @default(now())
  translations    ResearchTranslation[]
  lecturers       LecturerResearch[]
}

model ResearchTranslation {
  id            String            @id @default(cuid())
  researchId    String
  locale        Locale
  title         String            @db.VarChar(500)
  abstract      String?           @db.Text
  status        TranslationStatus @default(DRAFT)
  sourceVersion Int               @default(1)
  translatorId  String?
  reviewerId    String?
  reviewedAt    DateTime?
  research      Research          @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@unique([researchId, locale])
  @@index([locale])
}

model CommunityService {
  id           String                        @id @default(cuid())
  slug         String                        @unique
  year         Int
  location     String?
  documentUrl  String?
  translations CommunityServiceTranslation[]
  lecturers    LecturerCommunityService[]
}

model CommunityServiceTranslation {
  id                 String            @id @default(cuid())
  communityServiceId String
  locale             Locale
  title              String            @db.VarChar(500)
  description        String?           @db.Text
  status             TranslationStatus @default(DRAFT)
  sourceVersion      Int               @default(1)
  translatorId       String?
  reviewerId         String?
  reviewedAt         DateTime?
  communityService   CommunityService  @relation(fields: [communityServiceId], references: [id], onDelete: Cascade)

  @@unique([communityServiceId, locale])
  @@index([locale])
}

model LecturerResearch {
  lecturerId String
  researchId String
  createdAt  DateTime @default(now())
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@id([lecturerId, researchId])
}

model LecturerCommunityService {
  lecturerId         String
  communityServiceId String
  createdAt          DateTime         @default(now())
  lecturer           Lecturer         @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  communityService   CommunityService @relation(fields: [communityServiceId], references: [id], onDelete: Cascade)

  @@id([lecturerId, communityServiceId])
}

model LecturerPost {
  lecturerId String
  postId     String
  createdAt  DateTime @default(now())
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([lecturerId, postId])
}

model StudyProgramPost {
  studyProgramId String
  postId         String
  createdAt      DateTime     @default(now())
  studyProgram   StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  post           Post         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([studyProgramId, postId])
}

model Unit {
  id               String            @id @default(cuid())
  slug             String            @unique
  type             UnitType
  email            String?
  phone            String?
  externalUrl      String?
  isActive         Boolean           @default(true)
  version          Int               @default(1)
  contentOwnerId   String?
  governanceStatus GovernanceStatus  @default(CURRENT)
  lastReviewedAt   DateTime?
  lastReviewedById String?
  reviewDueAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  translations     UnitTranslation[]

  @@index([contentOwnerId, reviewDueAt])
}

model UnitTranslation {
  id            String            @id @default(cuid())
  unitId        String
  locale        Locale
  name          String
  description   String?           @db.Text
  status        TranslationStatus @default(DRAFT)
  sourceVersion Int               @default(1)
  translatorId  String?
  reviewerId    String?
  reviewedAt    DateTime?
  unit          Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, locale])
  @@index([locale])
}

model Service {
  id               String               @id @default(cuid())
  slug             String               @unique
  category         ServiceCategory
  url              String?
  icon             String?
  isActive         Boolean              @default(true)
  order            Int                  @default(0)
  version          Int                  @default(1)
  contentOwnerId   String?
  governanceStatus GovernanceStatus     @default(CURRENT)
  lastReviewedAt   DateTime?
  lastReviewedById String?
  reviewDueAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  translations     ServiceTranslation[]

  @@index([contentOwnerId, reviewDueAt])
}

model ServiceTranslation {
  id            String            @id @default(cuid())
  serviceId     String
  locale        Locale
  name          String
  description   String?           @db.Text
  status        TranslationStatus @default(DRAFT)
  sourceVersion Int               @default(1)
  translatorId  String?
  reviewerId    String?
  reviewedAt    DateTime?
  service       Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@index([locale])
}

model Partnership {
  id           String                   @id @default(cuid())
  slug         String                   @unique
  partnerName  String
  level        PartnershipLevel
  country      String?
