  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  questions   SurveyQuestion[]
  submissions SurveySubmission[]
}

model SurveyQuestion {
  id           String             @id @default(cuid())
  definitionId String
  prompt       String             @db.Text
  type         SurveyQuestionType
  options      Json?
  isRequired   Boolean            @default(false)
  order        Int                @default(0)
  definition   SurveyDefinition   @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  answers      SurveyAnswer[]
}

model SurveySubmission {
  id                String           @id @default(cuid())
  definitionId      String
  definitionVersion Int
  locale            Locale           @default(id)
  createdAt         DateTime         @default(now())
  definition        SurveyDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  answers           SurveyAnswer[]
}

model SurveyAnswer {
  id           String           @id @default(cuid())
  submissionId String
  questionId   String
  value        Json
  submission   SurveySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     SurveyQuestion   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([submissionId, questionId])
}

model RateLimitBucket {
  id           String    @id @default(cuid())
  keyHash      String
  scope        String
  windowStart  DateTime
  count        Int       @default(0)
  blockedUntil DateTime?

  @@unique([keyHash, scope, windowStart])
}

model NotificationOutbox {
  id                String       @id @default(cuid())
  type              String
  recipient         String
  locale            Locale       @default(id)
  template          String
  payload           Json?
  payloadEncrypted  Boolean      @default(false)
  payloadCiphertext String?      @db.Text
  encryptionNonce   String?
  encryptionTag     String?
  keyVersion        Int?
  idempotencyKey    String       @unique
  status            OutboxStatus @default(PENDING)
  attempts          Int          @default(0)
  nextAttemptAt     DateTime     @default(now())
  sentAt            DateTime?
  lastError         String?
  lockedAt          DateTime?
  lockedBy          String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, nextAttemptAt])
}

model Redirect {
  id              String   @id @default(cuid())
  sourcePath      String   @unique
  destinationPath String
  statusCode      Int      @default(301)
  isActive        Boolean  @default(true)
  hitCount        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GlossaryTerm {
  id           String                @id @default(cuid())
  key          String                @unique
  translations GlossaryTranslation[]
}

model GlossaryTranslation {
  id             String            @id @default(cuid())
  glossaryTermId String
  locale         Locale
  term           String
  definition     String?           @db.Text
  status         TranslationStatus @default(DRAFT)
  sourceVersion  Int               @default(1)
  translatorId   String?
  reviewerId     String?
  reviewedAt     DateTime?
  glossaryTerm   GlossaryTerm      @relation(fields: [glossaryTermId], references: [id], onDelete: Cascade)

  @@unique([glossaryTermId, locale])
  @@index([locale])
}

model SiteAlert {
  id            String                 @id @default(cuid())
  severity      AlertLevel
  audience      AlertAudience          @default(PUBLIC)
  startsAt      DateTime
  endsAt        DateTime?
  isDismissible Boolean                @default(true)
  isActive      Boolean                @default(true)
  createdById   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  translations  SiteAlertTranslation[]

  @@index([isActive, startsAt, endsAt])
}

model SiteAlertTranslation {
  id            String            @id @default(cuid())
  siteAlertId   String
  locale        Locale
  title         String
  message       String            @db.Text
  linkLabel     String?
  linkUrl       String?
  status        TranslationStatus @default(DRAFT)
  sourceVersion Int               @default(1)
  translatorId  String?
  reviewerId    String?
  reviewedAt    DateTime?
  siteAlert     SiteAlert         @relation(fields: [siteAlertId], references: [id], onDelete: Cascade)

  @@unique([siteAlertId, locale])
  @@index([locale])
}

model ServiceEndpoint {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  url       String?
  ownerId   String?
  isActive  Boolean           @default(true)
  isPublic  Boolean           @default(true)
  incidents ServiceIncident[]
}

model ServiceIncident {
  id                String                       @id @default(cuid())
  serviceEndpointId String
  severity          IncidentSeverity
  status            ServiceIncidentStatus        @default(INVESTIGATING)
  startedAt         DateTime
  resolvedAt        DateTime?
  serviceEndpoint   ServiceEndpoint              @relation(fields: [serviceEndpointId], references: [id], onDelete: Restrict)
  translations      ServiceIncidentTranslation[]
  updates           ServiceIncidentUpdate[]
}

model ServiceIncidentTranslation {
  id                String            @id @default(cuid())
  serviceIncidentId String
  locale            Locale
  title             String
  summary           String            @db.Text
  status            TranslationStatus @default(DRAFT)
  sourceVersion     Int               @default(1)
  translatorId      String?
  reviewerId        String?
  reviewedAt        DateTime?
  serviceIncident   ServiceIncident   @relation(fields: [serviceIncidentId], references: [id], onDelete: Cascade)

  @@unique([serviceIncidentId, locale])
  @@index([locale])
}

model ServiceIncidentUpdate {
  id                String                @id @default(cuid())
  serviceIncidentId String
  status            ServiceIncidentStatus
  locale            Locale                @default(id)
  message           String                @db.Text
  createdAt         DateTime              @default(now())
  serviceIncident   ServiceIncident       @relation(fields: [serviceIncidentId], references: [id], onDelete: Cascade)
}

model PrivacyNotice {
  id           String                     @id @default(cuid())
  version      Int                        @unique
  effectiveAt  DateTime
  retiredAt    DateTime?
  isCurrent    Boolean                    @default(false)
  createdAt    DateTime                   @default(now())
  translations PrivacyNoticeTranslation[]
  consents     ConsentRecord[]
}

model PrivacyNoticeTranslation {
  id              String            @id @default(cuid())
  privacyNoticeId String
  locale          Locale
  title           String
  content         String            @db.Text
  status          TranslationStatus @default(DRAFT)
  sourceVersion   Int               @default(1)
  translatorId    String?
  reviewerId      String?
  reviewedAt      DateTime?
  privacyNotice   PrivacyNotice     @relation(fields: [privacyNoticeId], references: [id], onDelete: Cascade)

  @@unique([privacyNoticeId, locale])
  @@index([locale])
}

model ConsentRecord {
  id              String        @id @default(cuid())
  privacyNoticeId String
  subjectHash     String
  purpose         String
  granted         Boolean
  userId          String?
  sessionId       String?
  createdAt       DateTime      @default(now())
  privacyNotice   PrivacyNotice @relation(fields: [privacyNoticeId], references: [id], onDelete: Restrict)

  @@index([subjectHash, purpose])
}

model DataSubjectRequest {
  id                   String               @id @default(cuid())
  requestNumber        String               @unique
  trackingTokenHash    String               @unique
  type                 PrivacyRequestType
  status               PrivacyRequestStatus @default(RECEIVED)
  verificationState    VerificationState    @default(PENDING)
  requesterCiphertext  String               @db.Text
  requestCiphertext    String               @db.Text
  assigneeId           String?
  resolutionCiphertext String?              @db.Text
  dueAt                DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  completedAt          DateTime?
}

model DataIncident {
  id                    String             @id @default(cuid())
  severity              IncidentSeverity
  occurredAt            DateTime
  discoveredAt          DateTime
  systemsAffected       Json
  dataCategories        Json
  containmentCiphertext String?            @db.Text
  summaryCiphertext     String             @db.Text
  status                DataIncidentStatus @default(OPEN)
  ownerId               String?
  resolvedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model DataExportLog {
  id           String    @id @default(cuid())
  actorId      String?
  resourceType String
  resourceId   String?
  purpose      String
  recordCount  Int
  storageKey   String?
  expiresAt    DateTime?
  downloadedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([actorId, createdAt])
}

model RetentionPolicy {
  id           String               @id @default(cuid())
  resourceType String               @unique
  legalBasis   String               @db.Text
  activeDays   Int?
  archiveDays  Int?
  disposition  RetentionDisposition
  legalHold    Boolean              @default(false)
  approverId   String?
  approvedAt   DateTime?
  rationale    String               @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model AccessibilityIssue {
  id            String                   @id @default(cuid())
  route         String
  wcagCriterion String
  description   String                   @db.Text
  summary       String
  severity      IncidentSeverity
  status        AccessibilityIssueStatus @default(OPEN)
  evidence      Json?
  ownerId       String?
  targetDate    DateTime?
  fixedAt       DateTime?
  retestResult  String?                  @db.Text
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  resolvedAt    DateTime?
}

model AccessibilityRequest {
  id                  String                     @id @default(cuid())
  requestNumber       String                     @unique
  trackingTokenHash   String                     @unique
  status              AccessibilityRequestStatus @default(RECEIVED)
  requesterCiphertext String                     @db.Text
  requestedFormat     String
  resourcePath        String
  createdAt           DateTime                   @default(now())
  completedAt         DateTime?
}

model AdmissionInfo {
  id             String                     @id @default(cuid())
  slug           String                     @unique
  sourceUrl      String
  lastReviewedAt DateTime
  reviewDueAt    DateTime?
  expiresAt      DateTime?
  isActive       Boolean                    @default(true)
  translations   AdmissionInfoTranslation[]
}

model AdmissionInfoTranslation {
  id              String            @id @default(cuid())
  admissionInfoId String
  locale          Locale
  title           String
  content         String            @db.Text
  status          TranslationStatus @default(DRAFT)
  sourceVersion   Int               @default(1)
  translatorId    String?
  reviewerId      String?
  reviewedAt      DateTime?
  admissionInfo   AdmissionInfo     @relation(fields: [admissionInfoId], references: [id], onDelete: Cascade)

  @@unique([admissionInfoId, locale])
  @@index([locale])
}

model PageFeedback {
  id        String   @id @default(cuid())
  pageType  String
  pageId    String
  locale    Locale
  helpful   Boolean
  reason    String?
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([pageType, pageId, locale])
}

model Subscriber {
  id                   String   @id @default(cuid())
  email                String   @unique
  locale               Locale   @default(id)
  isActive             Boolean  @default(true)
  unsubscribeTokenHash String   @unique
  createdAt            DateTime @default(now())
}

model HomeVideo {
  id           String                 @id @default(cuid())
  youtubeUrl   String
  order        Int                    @default(0)
  isVisible    Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  translations HomeVideoTranslation[]
}

model HomeVideoTranslation {
  id            String            @id @default(cuid())
  homeVideoId   String
  locale        Locale
  title         String
  status        TranslationStatus @default(DRAFT)
  sourceVersion Int               @default(1)
  translatorId  String?
  reviewerId    String?
  reviewedAt    DateTime?
  homeVideo     HomeVideo         @relation(fields: [homeVideoId], references: [id], onDelete: Cascade)

  @@unique([homeVideoId, locale])
  @@index([locale])
}

model Facility {
  id               String                @id @default(cuid())
  slug             String                @unique
  type             FacilityType          @default(BANGUNAN)
  isActive         Boolean               @default(true)
  order            Int                   @default(0)
  version          Int                   @default(1)
  coverMediaId     String?
  contentOwnerId   String?
  governanceStatus GovernanceStatus      @default(CURRENT)
  lastReviewedAt   DateTime?
  lastReviewedById String?
  reviewDueAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  coverMedia       Media?                @relation("FacilityCover", fields: [coverMediaId], references: [id], onDelete: Restrict)
  translations     FacilityTranslation[]

  @@index([contentOwnerId, reviewDueAt])
}

model FacilityTranslation {
  id            String            @id @default(cuid())
  facilityId    String
  locale        Locale
  name          String
  description   String?           @db.Text
  status        TranslationStatus @default(DRAFT)
  sourceVersion Int               @default(1)
  translatorId  String?
  reviewerId    String?
  reviewedAt    DateTime?
  facility      Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, locale])
  @@index([locale])
}

enum FacilityType {
  BANGUNAN
  LABORATORIUM
  PERPUSTAKAAN
  MUSHOLA
  AULA
  PARKIR
  KANTIN
  LAINNYA
}
