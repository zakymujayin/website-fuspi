    "@tiptap/extension-youtube": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "file-type": "^21.1.1",
    "isomorphic-dompurify": "^2.34.0",
    "lucide-react": "^0.577.0",
