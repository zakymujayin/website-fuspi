    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.0.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.1",
