    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.4.0",
    "shadcn": "^4.13.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
