DATABASE_URL="postgresql://fuspi:change-me@127.0.0.1:5432/fuspi_dev?connection_limit=10"

AUTH_SECRET="replace-with-at-least-32-random-bytes"
AUTH_URL="http://localhost:3004"

UPLOAD_DIR="/absolute/path/to/website-fuspi/uploads"
UPLOAD_PUBLIC_URL="http://localhost:3004/uploads"
UPLOAD_PRIVATE_DIR="/absolute/path/to/website-fuspi/private_uploads"
PPKS_PRIVATE_DIR="/absolute/path/to/website-fuspi/ppks_private"
UPLOAD_MAX_SIZE="5242880"
# Exactly 32 bytes, base64 encoded. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
# There is no development fallback: PPKS storage refuses to run without it.
PPKS_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
PPKS_ENCRYPTION_KEY_VERSION="1"
# On rotation, keep the previous key readable so existing reports still open:
#   PPKS_ENCRYPTION_KEY_V1="the-previous-base64-key"

TOKEN_HMAC_SECRET="replace-with-a-distinct-random-secret"
IP_HASH_SECRET="replace-with-a-distinct-random-secret"

SMTP_HOST="smtp.example.edu"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@fuspi.uinbanten.ac.id"
SMTP_PASSWORD="replace-in-secret-manager"
MAIL_FROM="FUSPI UIN Banten <noreply@fuspi.uinbanten.ac.id>"
SMTP_TIMEOUT_MS="10000"
OUTBOX_WORKER_ID="fuspi-outbox-01"
OUTBOX_BATCH_SIZE="25"
OUTBOX_LOCK_TIMEOUT_MS="300000"
OUTBOX_BASE_BACKOFF_MS="60000"
OUTBOX_MAX_BACKOFF_MS="3600000"

SEED_ADMIN_EMAIL="admin@fuspi.uinbanten.ac.id"
SEED_ADMIN_PASSWORD="replace-before-seeding"

NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_SITE_URL="http://localhost:3004"
NEXT_PUBLIC_SILA_URL=""
